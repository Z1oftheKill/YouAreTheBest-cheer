<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- namespace 必须和 Mapper 接口的完整路径 100% 一致 -->
<mapper namespace="com.cheer.demo.mapper.CheerTaskMapper">
    <!-- id 对应接口方法名；resultType 对应单行结果包装的 VO 类 -->
    <select id="countByCategory" resultType="com.cheer.demo.dto.CategoryStatVO">
        SELECT category, COUNT(*) AS count
        FROM cheer_task
        <where>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        GROUP BY category
    </select>
</mapper>